// Bhavani Fashion — database schema
// Money is stored as integers in paise (₹1 = 100 paise) to avoid floating-point errors.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  tagline     String?
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  /// Hidden categories (and their products) don't appear in the store
  isActive    Boolean   @default(true)
  /// Set for subcategories (e.g. Silk sarees under Sarees); one level deep only
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([parentId, sortOrder])
}

model Product {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  description      String
  fabric           String?
  occasion         String?
  care             String?
  /// Selling price in paise
  price            Int
  /// Original price in paise, shown struck-through when on sale
  compareAtPrice   Int?
  isFeatured       Boolean          @default(false)
  isNewArrival     Boolean          @default(false)
  isActive         Boolean          @default(true)
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([isActive, isNewArrival])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  sku       String  @unique
  color     String
  colorHex  String
  /// Null for free-size items such as sarees
  size      String?
  stock     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

// ─── Cart ────────────────────────────────────────────────────────────────────
// Anonymous carts, identified by an unguessable id kept in a cookie on the storefront.

model Cart {
  id        String     @id @default(cuid())
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
}

// ─── Orders ──────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  /// Cash to be collected on delivery
  COD_DUE
  /// Paid online but could not be fulfilled — refund required
  REFUND_DUE
  /// Refund issued (recorded by an admin)
  REFUNDED
}

model Order {
  id                String        @id @default(cuid())
  /// Human-friendly sequential number, shown as e.g. BF10001
  number            Int           @unique @default(autoincrement())
  status            OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)

  email             String
  phone             String
  fullName          String
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  pincode           String

  /// All amounts in paise
  subtotal          Int
  shippingFee       Int
  codFee            Int
  /// Coupon discount taken off the subtotal (0 when no coupon was used)
  discount          Int           @default(0)
  /// The coupon code as typed at checkout (kept even if the coupon is deleted later)
  couponCode        String?
  /// Set once the order counts towards the coupon's usage limit
  couponCounted     Boolean       @default(false)
  total             Int

  razorpayOrderId   String?       @unique
  razorpayPaymentId String?

  /// Cart that produced this order; emptied once the order is confirmed
  cartId            String?
  items             OrderItem[]
  events            OrderEvent[]

  courierName       String?
  trackingNumber    String?

  confirmedAt       DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

/// Timeline / audit trail of everything that happened to an order
model OrderEvent {
  id        String     @id @default(cuid())
  orderId   String
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// e.g. "status:SHIPPED", "payment:REFUNDED", "note"
  type      String
  message   String
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())

  @@index([orderId, createdAt])
}

// ─── Admin ───────────────────────────────────────────────────────────────────

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  /// argon2id hash — never store or log plain passwords
  passwordHash String
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  sessions     AdminSession[]
  orderEvents  OrderEvent[]
  activities   ActivityLog[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

/// Server-side session. The id is the SHA-256 of the random token held in the admin's cookie.
model AdminSession {
  id        String    @id
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([adminId])
}

/// A snapshot of what was bought, so later product edits never change past orders
model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  productSlug String
  imageUrl    String?
  color       String
  size        String?
  sku         String
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  @@index([orderId])
}

/// Home-page offer banners, managed from the admin panel
model Banner {
  id        String   @id @default(cuid())
  /// Small label above the headline, e.g. "The Festive Edit"
  eyebrow   String?
  /// Headline; the part in `highlight` is shown in italics after it
  title     String
  highlight String?
  subtitle  String?
  ctaLabel  String
  ctaHref   String
  imageUrl  String
  imageAlt  String   @default("")
  /// Which side of the photo the text sits on (tablet and desktop); pick the side without the model
  textSide  BannerTextSide @default(LEFT)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

enum BannerTextSide {
  LEFT
  RIGHT
}

enum CouponType {
  /// value is a percentage (1 to 90)
  PERCENT
  /// value is a fixed amount in paise
  FLAT
}

/// A discount code shoppers type at checkout, e.g. FESTIVE10
model Coupon {
  id          String     @id @default(cuid())
  /// Stored in capitals; matched without caring about case
  code        String     @unique
  /// Short note for the team, e.g. "Diwali Instagram post"
  description String?
  type        CouponType
  value       Int
  /// Smallest bag subtotal (paise) the code works on; 0 means any
  minOrder    Int        @default(0)
  /// Cap on a percentage discount, in paise; null means no cap
  maxDiscount Int?
  startsAt    DateTime?
  endsAt      DateTime?
  /// Total times the code can be used across all shoppers; null means unlimited
  usageLimit  Int?
  usedCount   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

/// Who changed what in the admin panel
model ActivityLog {
  id        String     @id @default(cuid())
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  /// Kept so the entry still reads right after the admin is removed
  adminName String
  /// Area of the panel: product, category, banner, order, coupon, offer, account, profile
  area      String
  /// One readable line, e.g. "Hid product Vana Handloom Cotton Saree"
  summary   String
  /// Admin page the entry points at, when it still exists
  href      String?
  createdAt DateTime   @default(now())

  @@index([createdAt])
  @@index([area, createdAt])
}

/// A store-wide percentage-off promotion (e.g. Black Friday). Applied to every live product's
/// price while it is switched on and inside its dates; nothing is written to product prices.
model Promotion {
  id         String    @id @default(cuid())
  /// Shown to shoppers, e.g. "Black Friday"
  name       String
  percentOff Int
  startsAt   DateTime?
  endsAt     DateTime
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
